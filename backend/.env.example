# REVORA backend environment — COPY to .env and fill real values.
# .env is git-ignored. NEVER commit real secrets.

# local | staging | production
ENV=local

# Database. LEAVE EMPTY for local development (built-in SQLite at ./revora_local.db).
# For production, put your Postgres/Supabase connection string here, e.g.:
# postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# --- Razorpay TEST MODE (leave empty until you add your Test Mode keys) ---
# Test keys start with rzp_test_ . LIVE keys (rzp_live_) are refused by design.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: override API base (defaults to https://api.razorpay.com/v1)
RAZORPAY_BASE_URL=

# --- Supabase (production auth + database) ---
# URL is the PROJECT base URL (no /rest/v1), e.g. https://<ref>.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard → Settings → API → JWT Secret (shown once; can be regenerated)
SUPABASE_JWT_SECRET=

# Local-dev JWT signing secret — used only when ENV=local and Supabase is not
# configured. Auto-generated by: python -m app.infrastructure.scripts.dev_up
DEV_JWT_SECRET=

# --- Messaging (simulated by default; delivery is labeled as simulated) ---
MESSAGING_MODE=simulated
RESEND_API_KEY=

# Production helpers (Render sets these via dashboard — see docs/DEPLOY.md)
# AUTO_CREATE_TABLES=true creates the schema on first boot (idempotent; empty = false)
AUTO_CREATE_TABLES=
